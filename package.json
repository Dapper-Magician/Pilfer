{
  "name": "pilfer-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "relay": "PUPPETEER_SKIP_DOWNLOAD=true tsx server/index.ts",
    "start": "concurrently \"npm run dev\" \"npm run relay\"",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.16.0",
    "cheerio": "^1.0.0-rc.12",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "css-tree": "^2.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsdom": "^22.1.0",
    "mermaid": "^10.9.4",
    "postcss": "^8.4.31",
    "puppeteer": "^24.37.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "vite": "^7.3.1"
  }
}
