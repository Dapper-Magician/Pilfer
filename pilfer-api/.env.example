# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Playwright Configuration
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_VIEWPORT_WIDTH=1920
PLAYWRIGHT_VIEWPORT_HEIGHT=1080
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_WAIT_UNTIL=networkidle
PLAYWRIGHT_JAVASCRIPT=true
PLAYWRIGHT_USER_AGENT=Pilfer-Extraction-Bot/1.0 (+https://github.com/pilfer/pilfer)
PLAYWRIGHT_LOCALE=en-US
PLAYWRIGHT_TIMEZONE=America/New_York

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=pilfer:

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pilfer
POSTGRES_USER=pilfer
POSTGRES_PASSWORD=pilfer
POSTGRES_SSL=false
POSTGRES_POOL_SIZE=10

# Feature Flags
ENABLE_CACHING=true
ENABLE_METRICS=true
ENABLE_FRAMEWORK_DETECTION=true
ENABLE_PERFORMANCE_ANALYSIS=true
ENABLE_ASSET_HARVESTING=true

# Gemini API (for AI enhancement)
GEMINI_API_KEY=your-gemini-api-key-here
